  <!-- 빌드 후 셰이더·Data·assets·DLL을 exe 폴더로 복사 (바뀐 파일만) -->
  <Target Name="CopyGameFiles" AfterTargets="Build">
    <ItemGroup>
      <ShaderFiles Include="$(ProjectDir)shader.*" />
      <DataFiles Include="$(ProjectDir)Data\**\*" />
      <ObjFiles Include="$(ProjectDir)..\..\assets\obj\**\*" />
      <TextureFiles Include="$(ProjectDir)..\..\assets\textures\**\*" />
      <DllFiles Include="$(ProjectDir)..\..\external\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DllFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ShaderFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(OutDir)Data\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ObjFiles)" DestinationFolder="$(OutDir)assets\obj\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TextureFiles)" DestinationFolder="$(OutDir)assets\textures\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
